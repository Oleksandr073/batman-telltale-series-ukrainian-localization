# Game text files must keep Windows line endings (CRLF) on every computer, or the game import breaks.
data/game_text/original_data/** text eol=crlf
data/game_text/localized_data/** text eol=crlf
data/game_text/unique_original_data/** text eol=crlf
data/game_text/unique_localized_data/** text eol=crlf
data/choice_stats/** text eol=crlf
data/about_button/** text eol=crlf
data/feed_item/** text eol=crlf
# ...except the picture, which is binary
data/feed_item/**/*.d3dtx binary
